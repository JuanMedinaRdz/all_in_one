<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo de "Todo en uno": una taza de café humeante.

  Es un vector drawable (no PNG), así que se ve nítido en cualquier densidad y
  respeta la regla del proyecto de no usar logos rasterizados.

  El lienzo del icono adaptativo es de 108x108dp, pero solo el centro (~72dp)
  se ve siempre: por eso la taza vive dentro de ese margen seguro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cuerpo de la taza -->
    <path
        android:fillColor="#F4ECE1"
        android:pathData="M33,47 L71,47 L66.5,77 C66,81.2 62.8,83.5 59,83.5 L45,83.5 C41.2,83.5 38,81.2 37.5,77 Z" />

    <!-- Superficie del café, asomando por el borde -->
    <path
        android:fillColor="#C77B58"
        android:pathData="M35.2,48.6 m-0.2,0 a17,4.2 0 1,0 34,0 a17,4.2 0 1,0 -34,0" />

    <!-- Asa -->
    <path
        android:strokeColor="#F4ECE1"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M71,54 C80.5,54 85,58 85,62 C85,66 80.5,70 70,70" />

    <!-- Vapor -->
    <path
        android:strokeColor="#F4ECE1"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.85"
        android:pathData="M45,40 C40.5,34.5 49.5,31 45,25" />
    <path
        android:strokeColor="#F4ECE1"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.6"
        android:pathData="M59,40 C54.5,34.5 63.5,31 59,25" />
</vector>
