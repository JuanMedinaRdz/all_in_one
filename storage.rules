rules_version = '2';

// Imágenes de las notas. Misma lógica que Firestore: exige sesión (anónima)
// y limita el tamaño/tipo para que un archivo enorme no dispare costos.
service firebase.storage {
  match /b/{bucket}/o {

    match /workspace/main/{allPaths=**} {
      allow read: if request.auth != null;

      // La app ya comprime antes de subir; 8 MB es un tope de seguridad.
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
